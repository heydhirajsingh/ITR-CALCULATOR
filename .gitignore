# All runtime data is private by default. Keep only empty directory markers.
data/*
!data/uploads/
!data/exports/
!data/temp/
data/uploads/*
data/exports/*
data/temp/*
!data/uploads/.gitkeep
!data/exports/.gitkeep
!data/temp/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Guard against accidentally committing real financial documents.
*.pdf
*.xls
*.xlsx
*.zip
*.csv
!sample_data/*.csv

.env*
!.env.example
.pytest_cache/
.test-*/
